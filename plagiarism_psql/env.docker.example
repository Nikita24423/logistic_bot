# Скопируйте в `.env` в этой папке перед `docker compose up`:
#   cp env.docker.example .env

ANALYSIS_API_KEY=change-me-in-production
# auto | cpu | cuda (для Docker с GPU нужен NVIDIA runtime)
DEVICE=auto
# Опционально: число потоков CPU для BLAS/torch на CPU (по умолчанию до 8 или число ядер)
# TORCH_CPU_THREADS=8
# Сколько задач анализа выполняется одновременно; очереди университетов
# (1 университет = 1 очередь) обходятся по кругу
# ANALYSIS_CONCURRENCY=1

# --- Модели и калибровка (дефолты совпадают с кодом; менять не обязательно) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# AI_MODEL=sberbank-ai/rugpt3small_based_on_gpt2
# QDRANT_SCORE_THRESHOLD=0.80
# Порог лексического косинуса гибридного поиска (1.0 — дословная копия чанка)
# LEXICAL_SCORE_THRESHOLD=0.60
# Порог Жаккара смысловых 3-грамм для тира «перефраз» каскада
# PARAPHRASE_THRESHOLD=0.15
# AI_DETECT_D0=1.0
# AI_DETECT_SCALE=1.5
# Размер батча детектора ИИ (больше — быстрее, но выше пик памяти)
# AI_DETECT_BATCH_SIZE=8
# CORS для браузерных запросов напрямую к API (список origin через запятую)
# CORS_ALLOW_ORIGINS=

# Отсечение служебных разделов работы (титульный лист, содержание,
# список использованных источников, приложения) до анализа.
# 1 (по умолчанию) — вырезать: они не являются авторским текстом и искажают
#   процент в обе стороны (титульник и ГОСТ-записи совпадают дословно у всех,
#   объёмное приложение занижает процент по содержательной части).
# 0 — анализировать работу целиком (прежнее поведение).
# Переопределяется на один запрос полем "strip_sections" в теле POST /v1/analyze.
STRIP_SERVICE_SECTIONS=1

# --- Каскад заимствований ---
# Порог лексического ПОИСКА: ниже него совпадение не возвращается вовсе.
LEXICAL_SCORE_THRESHOLD=0.60
# Порог тира «дословное копирование» в отчёте. Должен быть ВЫШЕ порога поиска,
# иначе тир exact вырождается в «любой лексический хит».
EXACT_THRESHOLD=0.80

# --- Индексация ---
# 1 — проверенная работа добавляется в корпус сравнения (поведение по умолчанию).
# 0 — не добавлять: пробные проверки не засоряют пул сравнения.
# Переопределяется полем "index_document" в запросе.
INDEX_ANALYZED_DOCUMENTS=1

# Пересоздание коллекции Qdrant при несовместимости схемы (смена EMBEDDING_MODEL).
# 0 (по умолчанию) — сервис падает с ошибкой, корпус цел.
# 1 — коллекция пересоздаётся, ВСЕ проиндексированные работы удаляются.
ALLOW_COLLECTION_RECREATE=0

# --- Журнал async-джоб ---
# Путь к SQLite-файлу; в compose сюда смонтирован том analysis_jobs, поэтому
# job_id переживают рестарт контейнера. ":memory:" — без персистентности.
ANALYSIS_JOB_DB=/app/data/jobs.db
ANALYSIS_JOB_TTL_SEC=172800

# --- Лимиты входа (защита от исчерпания памяти) ---
ANALYSIS_MAX_CONTENT_CHARS=41943040
ANALYSIS_MAX_FILE_BYTES=26214400
ANALYSIS_MAX_UNCOMPRESSED_BYTES=209715200
ANALYSIS_MAX_PDF_PAGES=500
ANALYSIS_MAX_TEXT_CHARS=2000000

# Пауза перед повторной загрузкой моделей, если инициализация провалилась
# (самая частая причина — Qdrant, который ещё поднимается).
ANALYSIS_WORKER_RETRY_SEC=60
